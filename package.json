{
  "name": "wreckmarch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "dev": "node scripts/prepare-vendor.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-vendor.mjs && node scripts/build-static.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run && node scripts/prepare-vendor.mjs && node scripts/build-static.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
